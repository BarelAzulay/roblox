		Size = UDim2.new(1, -350, 0, 32),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	U.RewardSub = makeText(rewards, "Sub", "", "Body", 18, MUTED, {
		Position = UDim2.fromOffset(16, 44),
