local function buildDetail(detail)
	U.DetailEmpty = makeText(detail, "Hint", "Pick a pet to see its card.", "Body", 19, MUTED, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(1, -40, 0, 60),
		TextWrapped = true,
